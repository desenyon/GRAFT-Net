# Optional process environment settings. GRAFT-Net does not auto-load .env files.
# Tracking remains off until tracking.enabled=true is passed to a CLI.
# Export these deliberately, or use tracking.uri=... as a Hydra override.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Set before starting Python if hash randomization matters to your custom code.
PYTHONHASHSEED=0
