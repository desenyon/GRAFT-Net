# Environment configuration — copy to .env and fill in values
# NEVER commit .env itself

# MLflow tracking URI (default: local filesystem)
MLFLOW_TRACKING_URI=mlruns

# Optional: remote MLflow server
# MLFLOW_TRACKING_URI=http://localhost:5000

# Reproducibility
PYTHONHASHSEED=0

# Optional: Weights & Biases (future)
# WANDB_API_KEY=your_key_here
# WANDB_PROJECT=graft-net
